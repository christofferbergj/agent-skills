{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reply-ui/catalog.schema.json",
  "title": "Reply UI card",
  "description": "A compact reply card that reply.js draws as UI: a list of blocks, each an object with exactly one key naming its type. scripts/validate-card.py checks a payload against this file and supports only the keywords used here.",
  "type": "object",
  "required": ["ui"],
  "additionalProperties": false,
  "properties": {
    "ui": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 240 },
    "short": { "type": "string", "minLength": 1, "maxLength": 60 },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/outcomeBlock" },
        { "$ref": "#/$defs/deltaBlock" },
        { "$ref": "#/$defs/changeBlock" },
        { "$ref": "#/$defs/decisionBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/checksBlock" },
        { "$ref": "#/$defs/flowBlock" }
      ]
    },
    "outcomeBlock": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "description": "The headline: a status marker and the outcome in the reader's terms.",
          "type": "object",
          "required": ["status", "text"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["done", "risk", "blocked", "working"] },
            "text": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "deltaBlock": {
      "type": "object",
      "required": ["delta"],
      "additionalProperties": false,
      "properties": {
        "delta": {
          "description": "A measured before and after, with optional bars scaled to the largest value.",
          "type": "object",
          "required": ["label", "now", "was"],
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/short" },
            "now": { "$ref": "#/$defs/short" },
            "was": { "$ref": "#/$defs/short" },
            "bars": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [{ "$ref": "#/$defs/short" }, { "type": "number", "minimum": 0 }]
              }
            }
          }
        }
      }
    },
    "changeBlock": {
      "type": "object",
      "required": ["change"],
      "additionalProperties": false,
      "properties": {
        "change": {
          "description": "One pull request: its number, state, and what proves it.",
          "type": "object",
          "required": ["pr", "state"],
          "additionalProperties": false,
          "properties": {
            "pr": { "type": "integer", "minimum": 1 },
            "state": { "enum": ["draft", "open", "fixing", "blocked", "merged", "closed"] },
            "title": { "$ref": "#/$defs/short" },
            "sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
            "checks": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/short" } },
            "diff": { "$ref": "#/$defs/short" },
            "note": { "$ref": "#/$defs/text" },
            "url": { "type": "string", "pattern": "^https://", "maxLength": 300 }
          }
        }
      }
    },
    "decisionBlock": {
      "type": "object",
      "required": ["decision"],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "description": "The next step's options; rec marks the pick.",
          "type": "object",
          "required": ["options"],
          "additionalProperties": false,
          "properties": {
            "question": { "$ref": "#/$defs/text" },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": ["key", "text"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string", "pattern": "^[a-z]$" },
                  "text": { "$ref": "#/$defs/text" },
                  "rec": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "required": ["table"],
      "additionalProperties": false,
      "properties": {
        "table": {
          "description": "A comparison of items on the same points, at most six rows; pick is the row index marked with a star.",
          "type": "object",
          "required": ["columns", "rows"],
          "additionalProperties": false,
          "properties": {
            "columns": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/short" } },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": { "type": ["string", "number"], "maxLength": 120 }
              }
            },
            "pick": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "checksBlock": {
      "type": "object",
      "required": ["checks"],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "description": "A check list, worst first.",
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["status", "text"],
            "additionalProperties": false,
            "properties": {
              "status": { "enum": ["fail", "warn", "wait", "skip", "pass"] },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "flowBlock": {
      "type": "object",
      "required": ["flow"],
      "additionalProperties": false,
      "properties": {
        "flow": {
          "description": "An order of steps, such as the Now and After lines; mark is the index of the step to stress, often the outcome.",
          "type": "object",
          "required": ["steps"],
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/short" },
            "steps": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/short" } },
            "mark": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        }
      }
    }
  }
}
